// Jenkinsfile - Pipeline DevSecOps de "Sistema Alumnos" (SecureDev · Evaluación Parcial 3 · OCY1102)
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    // Revisa GitHub cada ~3 minutos: cada push (tuyo o un PR de Dependabot fusionado) dispara un build.
    triggers {
        pollSCM('H/3 * * * *')
    }

    environment {
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        ZAP_MINUTOS_ACTIVO = '2'
    }

    stages {
        stage('Build') {
            steps {
                dir('proyecto') {
                    script {
                        // Versión = 1.0.<nº de build>+<commit corto>: une cada despliegue con su commit (trazabilidad)
                        def sha = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                        env.APP_VERSION = "1.0.${env.BUILD_NUMBER}+${sha}"
                    }
                    echo "Versión de este build: ${env.APP_VERSION}"
                    sh 'git log -1 --format="Commit %h de %an: %s"'
                    // Cada build parte limpio: sin reportes viejos y con un entorno virtual nuevo
                    sh 'rm -rf .venv reports && mkdir -p reports'
                    sh 'python3 -m venv .venv'
                    sh '.venv/bin/pip install --quiet -r requirements.txt -r requirements-dev.txt'
                    sh '.venv/bin/python -m compileall -q app.py'
                }
            }
        }

        stage('Test') {
            steps {
                dir('proyecto') {
                    sh '.venv/bin/python -m pytest --junitxml=reports/junit.xml'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'proyecto/reports/junit.xml'
                }
            }
        }

        // >>> [SEGURIDAD]: Etapas "Security Review (SAST)" y "Dependency Management"
        stage('Security Review (SAST)') {
            steps {
                dir('proyecto') {
                    sh '''
                        .venv/bin/python -m flake8 app.py --max-line-length=140 --ignore=E501,W503 --output-file=reports/flake8.txt || true
                        .venv/bin/python -m bandit -r app.py -ll -f json -o reports/bandit.json
                        .venv/bin/python -m bandit -r app.py -ll -f txt | tee reports/bandit.txt
                    '''
                }
            }
        }

        stage('Dependency Management') {
            steps {
                dir('proyecto') {
                    sh '''
                        .venv/bin/pip install --quiet pip-audit || true
                        .venv/bin/python -m pip_audit -r requirements.txt -f json -o reports/pip_audit.json || true
                        .venv/bin/python -m pip_audit -r requirements.txt || true
                    '''
                }
            }
        }

        // >>> [ZAP]: Etapas "Deploy Staging" y "DAST - OWASP ZAP"
        stage('Deploy Staging') {
            steps {
                dir('proyecto') {
                    sh 'bash scripts/deploy.sh staging 5001'
                }
            }
        }

        stage('DAST - OWASP ZAP') {
            steps {
                dir('proyecto') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        sh '.venv/bin/python scripts/zap_scan.py http://jenkins:5001'
                    }
                }
            }
        }

        stage('Deploy Producción') {
            // >>> [GATE]: Solo despliega en producción si Build, Test, SAST y DAST aprobaron sin alertas graves
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                dir('proyecto') {
                    sh 'bash scripts/deploy.sh produccion 5000'
                    script { env.PRODUCCION = env.APP_VERSION }
                }
            }
        }
    }

    post {
        always {
            dir('proyecto') {
                // Registro de trazabilidad: build <-> versión <-> commit <-> pruebas <-> hallazgos <-> despliegue
                withEnv(["RESULTADO=${currentBuild.currentResult ?: 'SUCCESS'}"]) {
                    sh '.venv/bin/python scripts/trazabilidad.py || true'
                }
            }
            archiveArtifacts artifacts: 'proyecto/reports/**', allowEmptyArchive: true
        }
    }
}